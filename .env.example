# コピーして .env を作成してください（.env は Git 管理外です）
PORT=3000
HOST=127.0.0.1

# 管理パネル（/admin）とテストUI（/?test=1）の操作に必要なトークン。
# 16文字以上の推測されにくい値を設定してください。未設定の場合は起動ごとにランダム生成され、コンソールに表示されます。
ADMIN_TOKEN=

# ループバック（このPC）以外からの管理接続を許可するか（既定: false）。
# true にする場合も HOST を LAN 内のアドレスに限定し、インターネットには公開しないでください。
ADMIN_ALLOW_REMOTE=false

# 抽選で重複を避ける直近件数（色ごと）
MESSAGE_HISTORY_SIZE=10

# コメントでの色指定・おみくじの、視聴者ごとの再実行間隔（秒）
COMMAND_COOLDOWN_SEC=30

# 動作モード: simulation のみ対応（実連携は未実装）
# live を指定しても、実連携モジュールが未実装のため simulation で起動します
EVENT_MODE=simulation

# 将来の実連携用（現時点では未使用。値をソースコードに直書きしないこと）
TIKTOK_API_KEY=
TIKTOK_API_SECRET=
